# ===================== Invoice Keeper — пример настроек =====================
# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не коммитится: в нём пароли и токен бота.

# --------- Подключение к MySQL ---------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=invoice_keeper
DB_PASSWORD=13254768
DB_NAME=invoice_keeper
DB_POOL_SIZE=8

# --------- Администратор (задаётся только здесь, через API не меняется) ---------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=13254768
ADMIN_FULL_NAME=Администратор

# --------- Сессии ---------
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=invoice_keeper_session
# true — только для HTTPS
SESSION_COOKIE_SECURE=false

# --------- Время ---------
# Единый часовой пояс приложения и базы
APP_TIMEZONE=Europe/Moscow

# --------- Telegram ---------
# Токен от @BotFather и id чата, куда слать напоминания (у групп он отрицательный)
TELEGRAM_BOT_TOKEN=8849408276:AAG9Q3Ms333PODdt3HdJTm2-V-cZTIM0zCE
TELEGRAM_CHAT_ID=
# Кнопка «Оплачено» прямо в сообщении бота
TELEGRAM_PAID_BUTTON=true

# --------- Планировщик напоминаний ---------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Минимум по условию кейса — 3 дня
DEFAULT_REMIND_DAYS_BEFORE=3

# --------- CORS: адреса веб-панели через запятую ---------
CORS_ORIGINS=*
